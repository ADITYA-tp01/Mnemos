# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# LLM (OpenAI or Google). Required for the agent loop to reason.
# Leave blank to run in "recall-only" demo mode (no LLM calls).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: FalkorDB Cloud managed instance (stretch).
# FALKORDB_CLOUD_URL=